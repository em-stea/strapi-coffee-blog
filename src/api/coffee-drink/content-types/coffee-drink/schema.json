{
  "kind": "collectionType",
  "collectionName": "coffee_drinks",
  "info": {
    "singularName": "coffee-drink",
    "pluralName": "coffee-drinks",
    "displayName": "Coffee Drink"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "instructions": {
      "type": "text"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "sortOrder": {
      "type": "integer"
    },
    "drinks_category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::drink-category.drink-category"
    },
    "drink_recipe": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::drink-recipe.drink-recipe"
    }
  }
}
