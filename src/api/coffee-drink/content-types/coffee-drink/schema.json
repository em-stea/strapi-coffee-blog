{
  "kind": "collectionType",
  "collectionName": "coffee_drinks",
  "info": {
    "singularName": "coffee-drink",
    "pluralName": "coffee-drinks",
    "displayName": "Coffee Drink"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "instructions": {
      "type": "text"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "sortOrder": {
      "type": "integer"
    },
    "foamType": {
      "type": "enumeration",
      "enum": [
        "Microfoam",
        "Dense Foam",
        "No Foam"
      ]
    },
    "milk_ratio": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::milk-ratio.milk-ratio"
    },
    "drinks_category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::drink-category.drink-category"
    },
    "espresso_shot": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::espresso-shot.espresso-shot"
    },
    "serving_size": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::serving-size.serving-size"
    }
  }
}
