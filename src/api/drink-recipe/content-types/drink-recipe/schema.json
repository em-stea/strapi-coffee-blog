      "repeatable": false
    },
    "whiskey_ratio": {
      "type": "component",
      "component": "whiskey-ratio.whis",
      "repeatable": false
    },
    "syrup_ratio": {
      "type": "component",
      "component": "syrup-ratio.syrup-ratio",
      "repeatable": false
